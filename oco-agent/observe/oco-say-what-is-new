#!/bin/sh
# oco-agent says what newly came into view: an item taken up, a problem raised or handled. It is the
# lenses' focus over what the observatory observed, compared with last time - ocoeco says what is new,
# oco-agent's voice carries it; neither knows the other. The first time it only keeps what is in view.
# OCO_SAY=echo shows what would be said, saying nothing.
set -eu
at="$HOME/.local/share/ocoeco"
# what the author's own observatory observed (it gathers OCO and every other constellation he tends)
observed="$at/the-authors-observatory"
[ -d "$observed/.git" ] || git clone -q --depth 1 https://github.com/marshall-oco/marshall-oco.github.io "$observed"
git -C "$observed" fetch -q --depth 1 origin main && git -C "$observed" reset -q --hard origin/main
say=${OCO_SAY:-oco-agent say}
for lens in ${OCO_LENSES:-work problems}; do
    ocoeco focus "$lens" --observed "$observed/data" --since "$at/said/$lens.json" | while IFS= read -r line; do
        $say "$line" --to author
    done
done

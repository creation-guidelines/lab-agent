# Hands the watcher, in this repository, what it needs as GitHub secrets - read from this user's
# lab-agent files and given through standard input, never printed.
set -eu
repo=${1:-creation-guidelines/lab-agent}
export GH_TOKEN="${GH_TOKEN:-$(cat "$HOME/.config/lab-agent/token")}"
conf="$HOME/.config/lab-agent/notify.toml"
value() { sed -n "s/^$1 *= *\"\(.*\)\"/\1/p" "$conf" | head -1; }
tr -d '\n' < "$HOME/.config/lab-agent/token" | gh secret set LAB_TOKEN -R "$repo" >/dev/null
for pair in NTFY_SERVER:server NTFY_URGENT_TOPIC:urgent_topic NTFY_INFO_TOPIC:info_topic; do
	v=$(value "${pair#*:}"); [ -n "$v" ] || { echo "install: $conf has no ${pair#*:}" >&2; exit 1; }
	printf %s "$v" | gh secret set "${pair%%:*}" -R "$repo" >/dev/null
done
echo "the watcher's secrets are set in $repo"

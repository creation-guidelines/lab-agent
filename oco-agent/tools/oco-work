# oco-work - what every job that works on the ecosystem does, said once. A job begins `. oco-work` and
# then says only what is its own. Reading this does nothing: each thing below is a word to use.
#
#   whole                      the author's observatory at its main: where one stands to look at the whole
#   fresh PLACE BRANCH [SHA]   a place at its main, on a new branch; with SHA, only if its main is still there.
#                              A job that stops leaves that place as its main has it
#   change FILE <<'CHANGE'     in FILE, the exact text above the line "--- becomes ---" becomes the text
#                              below it, once; it stops where that text is not there. Only what changes is
#                              sent - never a whole file to change a few of its lines
#   stand THING...             stand on each thing; the record of work then says where it was made - in a
#                              trail of the job's own: the driver who asked stays where they stand
#   enter ENTRY --flag ...     make an entry, or stop and say why not
#   fits1 ENTRY --flag BEGUN   the one thing that fits what was begun: never an id typed from memory
#   rust_checked               format, lint, run the guards of, and build the Rust of the place one is in
#   tried / kept               put the program just built in place of the one in use, which is kept and put
#                              back if the job stops; `kept` says the trial is over and the new one stays
#   looks_kept NAME LENS...    keep how these lenses look now, from the observatory - looked at in passing,
#                              so that comparing how a thing looks does not stand on it
#   looks_same NAME            stop unless they look as they did when kept - but for what moves by itself
#   timed COMMAND...           how long a command takes
#   landit SUMMARY [KIND]      check, record, commit and land the place one is in, and be back at its main;
#                              a place kept by tad is checked by tad (and make verify) and committed, no glimpse;
#                              where that place keeps these words, the ones that landed are put to use
#   holds_everywhere           stop unless every place under ~/Projects holds
#   released REPO              merge the release pull request of owner/repo, once it is there; wait until
#                              the release has its files - as many as the one before it - and bring the
#                              place held to its main: a release is said once it can be taken
#   straight SUMMARY [KIND]    check, record, commit and push the place one is in straight onto its main:
#                              for a place that takes what is entered without a pull request - the
#                              conversation - after `fresh PLACE main`
#   turn ID AFTER AT TEXT [SAID]  enter a turn of the author's into the conversation, as it was said and
#                              with the moment it was said (AT, as 2026-11-15T18:44:00Z); it stops where
#                              the conversation's place does not hold with it
#   settled REPO WORKFLOW      wait until none of a workflow's runs is under way, and say how the latest ended
#   shown FILE...              show files to the driver who asked - a page, a screenshot: each is put, under
#                              its own name, where the driver brings it from (brought NAME, on its side)
#   said [WORDS]               say WORDS in the window - ocoeco, said with no command: a mark, a lens, an
#                              entry by its name with what it asks on standard input, back, up - and land
#                              what was entered, in the place it was kept in (window WORDS, on a driver's side)
#
# To compare before and after a change to a program: look before with the changed files already in place
# and the program as it was - looks_kept after the changes, before `tried` - so that only the program
# differs. A guard added, a step taken, a minute passed are otherwise taken for what the change did.
# And compare looks that do not count everything in view - signs, work, purpose - where the change is to
# the language itself: a part of a lens is a thing, so a lens that gains a part adds one to every count
# of the whole, and rightly.

export GH_TOKEN="$(cat ~/.config/lab-agent/token)"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export OCOECO_BY="${OCOECO_BY:-claude}" LAND_RELEASE=0
# the commits are signed by who made them - the name a session works under (OCOECO_BY): where the commits and
# pull requests are the record of work (linux-phone-oco, since 2026-11-17), the face reads that name off them
export GIT_AUTHOR_NAME="$OCOECO_BY" GIT_AUTHOR_EMAIL=agent@creation-guidelines
export GIT_COMMITTER_NAME="$OCOECO_BY" GIT_COMMITTER_EMAIL=agent@creation-guidelines
set -o pipefail

PLACES="$HOME/Projects"
OBSERVATORY="$PLACES/marshall-oco/marshall-oco.github.io"
OCOECO=open-commons-observatory/ocoeco
ECOSYSTEM=open-commons-observatory/ecosystem
FIRST_OBSERVATORY=open-commons-observatory/open-commons-observatory.github.io
AUTHORS_OBSERVATORY=marshall-oco/marshall-oco.github.io
CONVERSATION=marshall-oco/conversation
LAB_AGENT=creation-guidelines/lab-agent
# where the language's place is held on the lab: every look and check a job makes reads the language as its
# place keeps it - also a place's own check, made where the language's place is not in view
export OCOECO_LANGUAGE="$PLACES/$OCOECO"
_oco_tried="/tmp/oco-work-tried-$$"
_oco_looks="/tmp/oco-work-looks-$$"
# a job's trail is its own: what it stands on says where its work was made, and is no step of the driver who
# asked for it. The window, said within a job, is the driver's own act: it steps where the driver stands, and
# what it enters lands with where the driver stood
_oco_trail="/tmp/oco-work-trail-$$"
mkdir -p "$_oco_trail"

stop() {
    if [ -f "$_oco_tried" ]; then
        install -m 755 "$HOME/.local/bin/ocoeco.before" "$(command -v ocoeco)"
        rm -f "$_oco_tried"
        echo "  the program from before is back in place"
    fi
    # and the place it was working in is put back as its main has it: what a stopped job left half done
    # is otherwise what every look from elsewhere sees of that place, until the next job there
    if [ -n "${_oco_place:-}" ] && [ -d "$_oco_place/.git" ]; then
        (cd "$_oco_place" && git checkout -q -- . 2>/dev/null; git clean -qfd 2>/dev/null
            git checkout -q main 2>/dev/null && git reset -q --hard origin/main 2>/dev/null)
        echo "  ${_oco_place#"$PLACES"/} is back as its main has it"
    fi
    echo "STOPPING: $1"
    exit 1
}

enter() {
    ocoeco glimpse "$@" >/dev/null || { ocoeco glimpse "$@" 2>&1 | tail -2 | cut -c1-240; stop "entering $1 ${3:-}"; }
}

fits1() { ocoeco fits glimpse "$@" | head -1 | cut -d" " -f1; }

whole() {
    (cd "$OBSERVATORY" && git fetch -q && git checkout -q main && git reset -q --hard origin/main && git clean -qfd) ||
        stop "the observatory could not be brought to its main"
}

fresh() {
    cd "$PLACES/$1" || stop "no place is held at $1"
    _oco_place="$PLACES/$1"
    git fetch -q origin && git checkout -q main && git reset -q --hard origin/main && git clean -qfd &&
        git checkout -q -B "$2" origin/main || stop "a branch in $1"
    if [ -n "${3:-}" ] && [ "$(git rev-parse HEAD)" != "$3" ]; then
        stop "the main of $1 has moved since its files were looked at"
    fi
}

change() {
    local all old new
    all=$(mktemp) old=$(mktemp) new=$(mktemp)
    cat > "$all"
    grep -qx -- '--- becomes ---' "$all" || stop "a change to $1 does not say what the text becomes"
    awk -v old="$old" -v new="$new" 'after { print > new; next } $0 == "--- becomes ---" { after = 1; next } { print > old }' "$all"
    swap "$1" "$old" "$new" || stop "in $1 the text to change is not where it was expected"
    rm -f "$all" "$old" "$new"
}

stand() {
    local thing
    for thing in "$@"; do
        (cd "$OBSERVATORY" && XDG_DATA_HOME="$_oco_trail" ocoeco focus "around@$thing" >/dev/null 2>&1) || stop "standing on $thing"
    done
}

rust_checked() {
    local out
    cargo fmt || stop "the format"
    cargo clippy --all-targets -q -- -D warnings >/dev/null 2>&1 || {
        cargo clippy --all-targets -q -- -D warnings 2>&1 | grep -E "^error" -A14 | head -60
        stop "the lint"
    }
    out=$(cargo test 2>&1)
    if echo "$out" | grep -q "FAILED\|panicked"; then
        echo "$out" | grep -E "panicked|left:|right:|Error" -A6 | cut -c1-400 | head -40
        stop "the guards"
    fi
    echo "  $(echo "$out" | grep -E 'test result: ok' | awk '{s+=$4} END {print s}') guards hold"
    cargo build -q --release || stop "the build"
    cargo fmt --check >/dev/null 2>&1 || stop "the format, as the checks on GitHub ask it"
}

tried() {
    cp "$(command -v ocoeco)" "$HOME/.local/bin/ocoeco.before" &&
        install -m 755 target/release/ocoeco "$(command -v ocoeco)" && touch "$_oco_tried" ||
        stop "putting the program just built in place"
}

kept() { rm -f "$_oco_tried"; }

# what moves by itself between two looks: how long ago, how long it took
unmoved() {
    sed -E 's/- [0-9]+ min ago/- N min ago/; s/, [0-9]+ min ago/, N min ago/; s/being done for [0-9]+ min/being done for N min/; s/the last at [0-9: -]*/the last at T/; s/ - gathered in [0-9]+ ms[^;]*//'
}

# a look taken to compare is in passing: a job checking how a thing looks is not a driver standing on it
_oco_look() { (cd "$OBSERVATORY" && ocoeco focus "$1" --passing 2>&1) | unmoved; }

looks_kept() {
    local name="$1" lens
    shift
    mkdir -p "$_oco_looks/$name" && rm -f "$_oco_looks/$name"/* "$_oco_looks/$name"/.lenses
    for lens in "$@"; do
        _oco_look "$lens" > "$_oco_looks/$name/$(echo "$lens" | tr '/@: ' '----')"
        echo "$lens" >> "$_oco_looks/$name/.lenses"
    done
}

looks_same() {
    local name="$1" lens kept same=0 all=0
    while read -r lens; do
        all=$((all + 1))
        kept="$_oco_looks/$name/$(echo "$lens" | tr '/@: ' '----')"
        if _oco_look "$lens" | cmp -s - "$kept"; then
            same=$((same + 1))
        else
            echo "  $lens differs:"
            _oco_look "$lens" | diff "$kept" - | grep '^[<>]' | head -4 | cut -c1-150
        fi
    done < "$_oco_looks/$name/.lenses"
    echo "  $all looks show what they showed: $same of $all"
    [ "$same" = "$all" ] || stop "a look changed"
}

timed() { { time -p "$@" >/dev/null 2>&1; } 2>&1 | awk '/^real/ { print $2 "s" }'; }

landit() {
    local out check=(ocoeco check)
    [ "${#1}" -le 88 ] || stop "the summary is ${#1} characters and at most 88 fit: $1"
    # a place kept by tad (tables.toml beside its data) is checked by tad alone, as its CI checks it - its rows
    # and rules, and its pages where it renders them - and depends on nothing of ocoeco (the author, 2026-11-17)
    if [ -f tables.toml ]; then
        out=$(tad check < /dev/null 2>&1) || { echo "$out" | tail -5; stop "the data at $PWD does not hold"; }
        if grep -q '^verify:' Makefile 2>/dev/null; then
            out=$(make -s verify < /dev/null 2>&1) || { echo "$out" | tail -5; stop "the place at $PWD is not as its CI checks it"; }
        fi
    elif grep -q '^id = "linux-phone-oco/' oco.toml 2>/dev/null; then
        # linux-phone depends on nothing of ocoeco (the author, 2026-11-17): a place of it without a tad base is
        # checked by its own CI, which land waits for - no ocoeco check here
        :
    else
        # a change to the language is checked where it is read: with the places beside the language's place,
        # every lens they keep comes into focus with the language as it would land
        if [ "${PWD#"$PLACES"/}" = "$OCOECO" ] && [ -n "$(git diff --name-only origin/main -- language)" ]; then
            check+=(--root "$PLACES")
        fi
        out=$("${check[@]}" < /dev/null 2>&1)
        echo "$out" | tail -1 | grep -q "all is well" || {
            echo "$out" | grep FAIL | head -3 | cut -c1-220
            stop "the place at $PWD does not hold"
        }
    fi
    # a place that keeps its record of work in glimpses says it as one; a place that exports none (linux-phone-oco,
    # since 2026-11-17) has its record in the commit itself, and the commit is all there is to make
    if [ ! -f tables.toml ] && grep -qE '^glimpses[[:space:]]*=' oco.toml 2>/dev/null; then
        XDG_DATA_HOME="$_oco_trail" ocoeco glimpse "$1" --kind "${2:-docs}" >/dev/null && ocoeco commit >/dev/null || stop "recording the work in $PWD"
    elif [ -n "$(git status --porcelain)" ]; then
        git add -A && git commit -qm "${2:-docs}: $1" || stop "committing the work in $PWD"
    fi
    out=$(land --no-manual 2>&1)
    if echo "$out" | grep -q "merged into"; then
        echo "  landed: ${PWD#"$PLACES"/}"
    else
        echo "$out" | tail -5
        stop "landing $PWD"
    fi
    # back at main as GitHub has it: on main where this clone may check it out, else (a worktree, while
    # another clone holds main) detached at origin/main - as land's own at_main does
    git fetch -q && { { git checkout -q main 2>/dev/null && git reset -q --hard origin/main; } || git checkout -q --detach origin/main; }
    [ "${PWD#"$PLACES"/}" != "$LAB_AGENT" ] || _oco_words_in_use
    _oco_place=""
}

# the words every job uses are the ones that landed: where the place that keeps them is at its main and
# holds other words than the ones in use, those take their place - and the next job begins with them. The
# job that landed them goes on with the words it began with
_oco_words_in_use() {
    local landed="$PLACES/$LAB_AGENT/oco-agent/tools/oco-work"
    [ -f "$landed" ] && [ "$(git -C "$PLACES/$LAB_AGENT" rev-parse --abbrev-ref HEAD 2>/dev/null)" = main ] || return 0
    cmp -s "$landed" "$HOME/.local/bin/oco-work" && return 0
    install -m 755 "$landed" "$HOME/.local/bin/oco-work" && echo "  in use from the next job on: the words that landed"
}

# the place one is in holds against every other - and, asked of the whole from the observatory, no link in
# view points nowhere: a check of a place looks at that place, so a link into it from elsewhere is seen
# only there
holds_everywhere() {
    # where one stands in a place, that place against every other; the whole is asked from anywhere
    [ ! -f oco.toml ] || ocoeco check --root "$PLACES" | tail -1 | grep -q "all is well" || {
        ocoeco check --root "$PLACES" | grep FAIL | head -3 | cut -c1-200
        stop "a place does not hold"
    }
    local nowhere
    nowhere=$(cd "$OBSERVATORY" && ocoeco focus edges --passing | grep 'holds: false')
    [ -z "$nowhere" ] || {
        echo "$nowhere" | head -3 | cut -c1-200
        stop "a link in view points nowhere"
    }
}

# a release is said once it can be taken: its pull request merged, the release there with its files - as
# many as the one before it had - and the place held brought to its main, so that a look over the places
# held sees it
released() {
    local n="" tries=0 before now="" had has=0
    # the newest release said: a draft is not yet said - the package conveyor says it once its files are there
    before=$(gh release list --repo "$1" --limit 1 --exclude-drafts --json tagName -q '.[0].tagName' 2>/dev/null)
    while [ -z "$n" ] && [ "$tries" -lt 9 ]; do
        n=$(gh pr list --repo "$1" --state open --json number,title -q '[.[] | select(.title | test("release"))][0].number' 2>/dev/null)
        [ -n "$n" ] || { tries=$((tries + 1)); sleep 20; }
    done
    [ -n "$n" ] || { echo "  no release of $1 is waiting"; return 0; }
    if ! gh pr merge "$n" --repo "$1" --squash >/dev/null 2>&1; then
        echo "  the release of $1 could not be merged"
        return 0
    fi
    echo "  released: $(gh pr view "$n" --repo "$1" --json title -q .title)"
    had=$(gh api "repos/$1/releases/tags/$before" --jq '.assets | length' 2>/dev/null)
    tries=0
    while [ "$tries" -lt 60 ]; do
        now=$(gh release list --repo "$1" --limit 1 --exclude-drafts --json tagName -q '.[0].tagName' 2>/dev/null)
        if [ -n "$now" ] && [ "$now" != "$before" ]; then
            has=$(gh api "repos/$1/releases/tags/$now" --jq '.assets | length' 2>/dev/null)
            [ "${has:-0}" -ge "${had:-0}" ] && break
        fi
        tries=$((tries + 1))
        sleep 15
    done
    if [ -d "$PLACES/$1/.git" ] && [ "$(git -C "$PLACES/$1" rev-parse --abbrev-ref HEAD)" = main ]; then
        git -C "$PLACES/$1" fetch -q && git -C "$PLACES/$1" reset -q --hard origin/main
    fi
    if [ -n "$now" ] && [ "$now" != "$before" ] && [ "${has:-0}" -ge "${had:-0}" ]; then
        echo "  $now can be taken: ${has:-0} file(s), as the one before it had"
    else
        echo "  the new release of $1 does not have its files yet: ${has:-0} of ${had:-0}"
    fi
}

# for a place that takes what is entered straight on its main - the conversation: the place one is in is
# checked, recorded, committed and pushed as it stands
straight() {
    [ "${#1}" -le 88 ] || stop "the summary is ${#1} characters and at most 88 fit: $1"
    [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || stop "straight is for a place on its main, and $PWD is on another branch"
    ocoeco check | tail -1 | grep -q "all is well" || {
        ocoeco check | grep FAIL | head -3 | cut -c1-220
        stop "the place at $PWD does not hold"
    }
    XDG_DATA_HOME="$_oco_trail" ocoeco glimpse "$1" --kind "${2:-docs}" >/dev/null && ocoeco commit >/dev/null && git push -q origin main || stop "keeping the work in $PWD"
    echo "  kept on its main: ${PWD#"$PLACES"/}"
    _oco_place=""
}

# what a job shows goes the one way a driver and the lab share: the jobs repository, on a branch of its own
shown() {
    local f n sha via="${OCO_AGENT_VIA:-grenudi/lab-agent-jobs}"
    for f in "$@"; do
        [ -s "$f" ] || { echo "  not shown, for it is not there: $f"; continue; }
        n=$(basename "$f")
        sha=$(gh api "repos/$via/contents/shots/$n?ref=shots" -q .sha 2>/dev/null || true)
        if base64 -w0 "$f" | jq -Rn --arg m "shown: $n" --arg s "$sha" \
            '{message: $m, branch: "shots", content: input} + (if $s == "" then {} else {sha: $s} end)' |
            gh api -X PUT "repos/$via/contents/shots/$n" --input - -q .content.path >/dev/null 2>&1; then
            echo "  shown: $n"
        else
            echo "  not shown: $n"
        fi
    done
}

# what runs elsewhere - a harvest, an observing - is waited for here, once: until none is under way
settled() {
    local n=0 under
    while [ "$n" -lt 60 ]; do
        under=$(gh run list --repo "$1" --workflow "$2" --limit 6 --json status -q '[.[] | select(.status != "completed")] | length' 2>/dev/null)
        [ "${under:-1}" = 0 ] && break
        n=$((n + 1))
        sleep 20
    done
    echo "  $1 $2: $(gh run list --repo "$1" --workflow "$2" --limit 1 --json conclusion,createdAt -q '.[0] | "\(.conclusion) \(.createdAt[11:19])"' 2>/dev/null)"
}

turn() {
    local id="$1" after="$2" at="$3" text="$4" said="${5:-continue}" there="$PLACES/$CONVERSATION"
    (cd "$there" && git checkout -q main && git pull -q) || stop "the conversation's place could not be brought to its main"
    (cd "$there" && OCOECO_BY=mll ocoeco glimpse turn --id "$id" --by "the author" --after "$after" --at "$at" --text "$text" >/dev/null) || stop "the turn was not entered"
    (cd "$there" && ocoeco check | tail -1 | grep -q "all is well") || {
        (cd "$there" && git checkout -q -- .)
        stop "the conversation's place does not hold with the turn"
    }
    (cd "$there" && ocoeco glimpse "a turn entered as it was said: $said" --kind docs >/dev/null && ocoeco commit >/dev/null && git push -q) || stop "the turn was not kept"
    echo "  the turn is entered: $id"
}

# what is said in the window - where an entry is made by saying its name and what it asks - is landed as it
# is entered: the window says where it was kept, and this lands that place
said() {
    local out places kept first more summary
    # the driver's own act: what it enters lands with where the driver stood
    local _oco_trail="${XDG_DATA_HOME:-$HOME/.local/share}"
    out=$(cd "$OBSERVATORY" && ocoeco "$@" 2>&1)
    echo "$out"
    # what one saying entered, place by place: all it entered in a place lands as one
    places=$(echo "$out" | sed -n 's/^entered: \([^ ]*\) | .*/\1/p' | awk '!seen[$0]++')
    [ -n "$places" ] || return 0
    for kept in $places; do
        first=$(echo "$out" | grep -F "entered: $kept | " | head -1)
        more=$(( $(echo "$out" | grep -cF "entered: $kept | ") - 1 ))
        summary=${first#"entered: $kept | "}
        [ "$more" -gt 0 ] && summary="$(echo "$summary" | cut -c1-72), and $more more"
        summary=$(echo "$summary" | cut -c1-88)
        cd "$PLACES/$kept" || stop "what was entered is kept in $kept, and no such place is held"
        _oco_place="$PLACES/$kept"
        if [ "$kept" = "$CONVERSATION" ]; then
            straight "$summary"
        else
            git checkout -q -b "said/$(date +%s)" && landit "$summary"
        fi
    done
}

# A per-user systemd unit (no root needed day-to-day): ~/.config/systemd/user/lab-agent.service
# Installed and enabled by deploy/connect.sh. Needs `loginctl enable-linger $(whoami)` (once, as root) so it keeps running
# without an active login session - connect.sh checks for this and tells you the one line to run if it is missing.
[Unit]
Description=lab-agent: runs jobs pulled from git, reports progress through git
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The token lives only in this one file (chmod 600, written by connect.sh), never in config.toml or committed anywhere.
EnvironmentFile=%h/.config/lab-agent/env
ExecStart=%h/.local/share/lab-agent/venv/bin/lab-agent --config %h/.config/lab-agent/config.toml
Restart=always
RestartSec=5
StartLimitIntervalSec=0
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=default.target

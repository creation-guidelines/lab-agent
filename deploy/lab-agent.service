[Unit]
Description=lab-agent: runs jobs pulled from git, reports progress through git
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A plain, unprivileged user (see deploy/install.sh); it must have whatever device access (udev rules, dialout/plugdev groups)
# the job scripts themselves need, but no more.
ExecStart=/usr/bin/python3 -m lab_agent.agent --config /etc/lab-agent/config.toml
# Always restart, with no limit: a crash in agent.py's own code (a bug outside the per-pass try/except in run_forever) must
# not leave the lab silently unattended. The job that was mid-flight is recorded as interrupted and the loop continues.
Restart=always
RestartSec=5
StartLimitIntervalSec=0
# The *agent* gets a short window to shut down cleanly on stop/restart; a running *job* is a separate process group (see
# runner.py) and is deliberately left running, to be picked up again on the next start rather than killed by systemd here.
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

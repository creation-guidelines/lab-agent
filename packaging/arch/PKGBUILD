# Maintainer: creation-guidelines
#
# Builds lab-agent from a release tag. The release workflow publishes this file with `pkgver`
# and `sha256sums` filled in.

pkgname=lab-agent
pkgver=0.1.0
pkgrel=1
pkgdesc='Pull-based job runner: polls a git repo for jobs, runs them on real hardware, reports results through git'
arch=('x86_64' 'aarch64')
url='https://github.com/creation-guidelines/lab-agent'
license=('MIT')
makedepends=('cargo')
# ring (a transitive TLS dependency, via ureq) mixes C/assembly with Rust FFI; Arch's default LTO
# renames/strips symbols across that boundary and the link fails with "undefined symbol:
# ring_core_..." - a known interaction, not specific to this package. Disabled here only.
options=('!lto')
_dir="${_dir:-$pkgname-$pkgver}"
source=("${_source:-$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz}")
sha256sums=('SKIP')

prepare() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$_dir"
  install -Dm755 target/release/lab-agent -t "$pkgdir/usr/bin/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  # Generated by the binary from its own argenv contract; never written by hand.
  local bin=target/release/lab-agent
  "$bin" completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/lab-agent"
  "$bin" completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_lab-agent"
  "$bin" completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/lab-agent.fish"
  "$bin" completions nushell | install -Dm644 /dev/stdin "$pkgdir/usr/share/nushell/vendor/autoload/lab-agent.nu"
  "$bin" man | gzip -9n | install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/lab-agent.1.gz"
}
